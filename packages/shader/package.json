{
  "name": "unity-asset-reader-shader",
  "version": "0.0.0",
  "description": "Shader inspection text for unity-asset-reader: GL and Metal source and SPIR-V disassembly, as AssetStudio writes it.",
  "license": "MIT AND BSD-2-Clause",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "LICENSE",
    "LICENSE-BSD",
    "NOTICE"
  ],
  "scripts": {
    "pretest": "npm run build",
    "build": "rollup -c rollup.config.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check:browser": "node ../../scripts/check-browser.mjs shader",
    "prepublishOnly": "npm run verify --prefix ../.."
  },
  "keywords": [
    "unity",
    "shader",
    "glsl",
    "metal",
    "spir-v",
    "smol-v",
    "browser"
  ],
  "peerDependencies": {
    "unity-asset-reader": "^1.2.0"
  },
  "devDependencies": {
    "unity-asset-reader": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fatal10110/unity-asset-reader.git",
    "directory": "packages/shader"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
