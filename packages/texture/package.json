{
  "name": "unity-asset-reader-texture",
  "version": "1.1.0",
  "description": "Texture2D and Sprite decoding to RGBA for unity-asset-reader.",
  "license": "MIT AND Apache-2.0",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "LICENSE",
    "LICENSE-APACHE",
    "NOTICE"
  ],
  "scripts": {
    "pretest": "npm run build",
    "build": "rollup -c rollup.config.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check:browser": "node ../../scripts/check-browser.mjs texture",
    "prepublishOnly": "npm run verify --prefix ../.."
  },
  "keywords": [
    "unity",
    "texture2d",
    "sprite",
    "rgba",
    "browser"
  ],
  "dependencies": {
    "texture2ddecoder-wasm": "^1.2.3"
  },
  "peerDependencies": {
    "unity-asset-reader": "^1"
  },
  "devDependencies": {
    "unity-asset-reader": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fatal10110/unity-asset-reader.git",
    "directory": "packages/texture"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
