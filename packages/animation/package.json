{
  "name": "unity-asset-reader-animation",
  "version": "1.0.0",
  "description": "AnimationClip curves and animated glTF scenes for unity-asset-reader: clips decoded as AssetStudio's .anim export holds them, and scenes with skins, blend shapes and clips (humanoid included) exported to glTF 2.0.",
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "pretest": "npm run build",
    "build": "rollup -c rollup.config.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check:browser": "node ../../scripts/check-browser.mjs animation",
    "prepublishOnly": "npm run verify --prefix ../.."
  },
  "keywords": [
    "unity",
    "animationclip",
    "animation",
    "curves",
    "gltf",
    "glb",
    "skinned-mesh",
    "humanoid",
    "browser"
  ],
  "peerDependencies": {
    "unity-asset-reader": "^1.3.0"
  },
  "devDependencies": {
    "gltf-validator": "2.0.0-dev.3.10",
    "unity-asset-reader": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fatal10110/unity-asset-reader.git",
    "directory": "packages/animation"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
