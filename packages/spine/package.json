{
  "name": "unity-asset-reader-spine",
  "version": "0.0.0",
  "description": "Spine skeleton export for unity-asset-reader: skeleton data, atlases and page textures as spine-unity stores them.",
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "pretest": "npm run build",
    "build": "rollup -c rollup.config.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check:browser": "node ../../scripts/check-browser.mjs spine",
    "prepublishOnly": "npm run verify --prefix ../.."
  },
  "keywords": [
    "unity",
    "spine",
    "spine-unity",
    "skeleton",
    "atlas",
    "browser"
  ],
  "peerDependencies": {
    "unity-asset-reader": "^1"
  },
  "devDependencies": {
    "unity-asset-reader": "*",
    "unity-asset-reader-texture": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fatal10110/unity-asset-reader.git",
    "directory": "packages/spine"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
